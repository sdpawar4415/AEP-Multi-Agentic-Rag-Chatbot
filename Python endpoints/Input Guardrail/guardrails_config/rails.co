define flow jailbreak check
  $jailbreak_hit = execute check_jailbreak_keywords
  if $jailbreak_hit.is_blocked
    bot say "BLOCKED_JAILBREAK"
    stop


define flow pii check
  $pii_hit = execute check_pii_patterns
  if $pii_hit.is_blocked
    bot say "BLOCKED_PII"
    stop


define flow toxicity check
  $toxicity_hit = execute check_toxicity_keywords
  if $toxicity_hit.is_blocked
    bot say "BLOCKED_TOXICITY"
    stop


define flow prompt injection check
  $prompt_hit = execute check_prompt_injection_keywords
  if $prompt_hit.is_blocked
    bot say "BLOCKED_PROMPT"
    stop


define flow html script check
  $html_hit = execute check_html_script_keywords
  if $html_hit.is_blocked
    bot say "BLOCKED_HTML"
    stop


define flow intent misalignment check
  $intent_hit = execute check_intent_misalignment_keywords
  if $intent_hit.is_blocked
    bot say "BLOCKED_INTENT"
    stop
